---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingRow from '../../components/ListingRow.astro';
import { sortListings } from '../../lib/sort';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const listings = await getCollection('listings');

  return categories.map((category) => ({
    params: { slug: category.data.slug },
    props: {
      category,
      listings: sortListings(
        listings.filter((l) => l.data.category === category.data.slug),
        'top'
      ),
    },
  }));
}

const { category, listings } = Astro.props;
const c = category.data;
const base = import.meta.env.BASE_URL;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  name: c.name,
  url: pageUrl,
  ...(c.description ? { description: c.description } : {}),
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: listings.length,
    itemListElement: listings.map((listing, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: listing.data.name,
      url: new URL(`${base}listings/${listing.data.slug}`.replace(/\/+/g, '/'), Astro.site ?? Astro.url).toString(),
    })),
  },
};
---
<BaseLayout title={c.name} description={c.description}>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={base}>Home</a><span>/</span>{c.name}
  </nav>

  <div class="page-head">
    <h1>
      {c.icon && <span class="category-icon" set:html={c.icon} />}
      {c.name}
    </h1>
    {c.description && <p class="page-head-desc">{c.description}</p>}
  </div>

  <section class="category-box category-box--wide">
    <div class="category-sites">
      {listings.length === 0
        ? <p class="category-description">Nothing here yet.</p>
        : listings.map((l, i) => <ListingRow listing={l} rank={i + 1} />)}
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
</BaseLayout>
