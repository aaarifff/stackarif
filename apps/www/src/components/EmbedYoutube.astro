---
interface Props {
	videoId: string;
	title?: string;
}

const { videoId, title = "Intro video" } = Astro.props;
const titleId = `embed-title-${videoId}`;
---

<section class="embed__container" aria-labelledby={titleId}>
	<h2 id={titleId} class="embed__title">{title}</h2>
	<div class="embed__video-wrap">
		<iframe
			class="embed__video"
			title="Embedded YouTube video"
			src={`https://www.youtube-nocookie.com/embed/${videoId}`}
			allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
			allowfullscreen
		></iframe>
	</div>
</section>

<style>
	.embed__container {
		width: 100%;
		padding: 2rem 1.4rem 0;
	}

	.embed__title {
		margin: 0 0 1rem;
		color: var(--text-bold-color);
		font-size: 2rem;
	}

	.embed__video-wrap {
		width: 100%;
		overflow: hidden;
		border-radius: 12px;
		aspect-ratio: 16 / 9;
		background: #000;
	}

	.embed__video {
		width: 100%;
		height: 100%;
		border: 0;
	}

	:global(.dark) .embed__title {
		color: aqua;
	}
</style>
